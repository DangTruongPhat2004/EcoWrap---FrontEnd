{
  "functions": {
    "api/location.mjs": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/proxy.mjs": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(?!location|proxy)(.+)",
      "destination": "http://14.225.205.215/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
